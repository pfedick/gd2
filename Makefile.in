VERSION ?= 0.0.1
PREVIOUS_TAG = 0.0.0
BUILD_NUMBER := $(shell git rev-list --all --count)
BUILDDATE := $(shell date '+%Y%m%d')

CXX			= @CXX@
EXTRA_CFLAGS = -ggdb -Wall
INCLUDE	= -Iinclude -Ipplib/include -Ippltk/include
CPPFLAGS	= @CPPFLAGS@
CXXFLAGS	= @CXXFLAGS@

CFLAGS		=  $(INCLUDE) $(EXTRA_CFLAGS) $(CXXFLAGS) @CFLAGS@ @DEFS@  @PTHREAD_CFLAGS@ \
	@FT2_CFLAGS@ \
	@DAV1D_CFLAGS@ @ZLIB_CFLAGS@ @BZ2_CFLAGS@ @PCRE2_CFLAGS@ @ICONV_CFLAGS@ \
	@MPG123_CFLAGS@	@SDL3_CFLAGS@ @VORBIS_CFLAGS@ @ASSIMP_CFLAGS@
LDFLAGS		= @LDFLAGS@
LIBS_PPL7 =  pplib/release/libppl7-audio.a  pplib/release/libppl7-gfx.a  pplib/release/libppl7-core.a
LIBS_PPLTK = ppltk/compile/libppltk.a
LIBS		= $(LIBS_PPL7)  $(LIBS_PPLTK) @ASAN_FLAGS@ \
	@LIBS@ @PTHREAD_CFLAGS@ @PTHREAD_LIBS@ @DAV1D_LIBS@ @ZLIB_LIBS@ @BZ2_LIBS@ @PCRE2_LIBS@ @FT2_LIBS@ \
	@PNG_LIBS@ @JPEG_LIBS@ @ICONV_LIBS@ @MPG123_LIBS@ @SDL3_LIBS@ @VORBIS_LIBS@ @VORBISFILE_LIBS@ @ASSIMP_LIBS@ \
	-lstdc++



PROGRAM	= gd2
APPNAME = gd2

OBJECTS=compile/main.o \
	compile/game.o \
	compile/sdl.o \
	compile/gpu.o \
	compile/gpubatcher.o \
	compile/fps.o \
	compile/config.o \
	compile/spritetexture.o \
	compile/gamecontroller.o \
	compile/resources.o \
	compile/renderpipelines.o \
	compile/background.o \
	compile/audio_audioinstance.o \
	compile/audio_audiopool.o \
	compile/audio_audiosample.o \
	compile/audio_audiostream.o \
	compile/audio_audiosystem.o


UI=compile/ui_menue.o \
	compile/ui_statusbar.o


$(PROGRAM): update_version ppl7 ppl_toolkit shaders $(OBJECTS) $(UI)
	$(CXX) -o $(PROGRAM) $(OBJECTS) $(UI) $(LIBS)
	-chmod 755 $(PROGRAM)

all: update_version $(PROGRAM) texmaker

shaders:
	@mkdir -p res/shaders/vulkan
	@# --- Core Sprite Shaders (using Storage Buffers for Transform) ---
	glslc res/shaders/src/sprite_ndc_storage.vert -o res/shaders/vulkan/sprite_ndc_storage.vert.spv
	glslc res/shaders/src/sprite.frag -o res/shaders/vulkan/sprite_ndc_storage.frag.spv
	@# --- Primitive Shaders (Lines, etc) ---
	glslc res/shaders/src/primitive.vert -o res/shaders/vulkan/primitive.vert.spv
	glslc res/shaders/src/primitive.frag -o res/shaders/vulkan/primitive.frag.spv
	@# --- PostFX / Helper Shaders ---
	glslc res/shaders/src/ndc_textured.vert -o res/shaders/vulkan/ndc_textured.vert.spv
	glslc -fshader-stage=fragment res/shaders/src/blur_horizontal.glsl -o res/shaders/vulkan/blur_horizontal.spv
	glslc -fshader-stage=fragment res/shaders/src/blur_vertical.glsl -o res/shaders/vulkan/blur_vertical.spv
	@# --- Debug ---
	glslc res/shaders/src/copy.frag -o res/shaders/vulkan/copy.frag.spv


mingw: update_version
	rm -rf release/deploy
	mkdir -p release/deploy
	make -j 16 ppl7
	make -j 16 ppl_toolkit
	make -j 16 $(PROGRAM)
	ldd  $(PROGRAM).exe  | grep -v WINDOWS | grep ucrt64 | awk '{print $$3}' | while read line  ; do cp $${line} release/deploy; done

	cat setup.tpl.iss | sed "s/^AppVersion=.*/AppVersion=${VERSION}.${BUILD_NUMBER}/"  \
		| sed "s/^AppVerName=.*/AppVerName=$(APPNAME) ${VERSION}/"  \
		| sed "s/^VersionInfoVersion=.*/VersionInfoVersion=${VERSION}/"  \
		| sed "s/^OutputBaseFilename=.*/OutputBaseFilename=${APPNAME}-${VERSION}-Setup/"  \
		> setup.iss
	cp $(PROGRAM).exe release/deploy
	strip release/deploy/$(PROGRAM).exe

setup: mingw
	"C:\Program Files (x86)\Inno Setup 5\ISCC.exe" setup.iss


history:
	@echo "Git history between Tag $(PREVIOUS_TAG) and head" >  history.tmp
	@echo "================================================================================" >>  history.tmp
	@git log --pretty=format:"%ad=!=%s" --date=iso8601-strict $(PREVIOUS_TAG)...main | sort | awk -F "=!=" '{ print $$2}' >> history.tmp
	cat history.tmp

ppl7:
	-mkdir -p pplib/release
	cd pplib && $(MAKE) -j release/libppl7-core.a
	cd pplib && $(MAKE) -j release/libppl7-gfx.a
	cd pplib && $(MAKE) -j release/libppl7-audio.a

ppl_toolkit:
	-mkdir -p ppltk/release
	cd ppltk && $(MAKE) -j

clean:
	-rm -f compile/*.o $(PROGRAM) *.core

cleanall:
	-rm -f compile/*.o $(PROGRAM) *.core
	cd pplib && $(MAKE) clean
	cd ppltk && $(MAKE) clean

hud:
	./texmaker -s lightwave/Render/hud/ -t res/hud.tex -w 512 -h 256 -px 50 -py 98 -x tmp/hud
	./texmaker -f res/cursor/cursor.lst -t res/cursor.tex -w 128 -h 128 -px 0 -py 0 -x tmp/cursor

sprites: hud

fonts:
	- rm -rf res/*.fnt6
	pplfontmaker -t res/notosans-black.fnt6 -q /usr/share/fonts/google-noto/NotoSans-Black.ttf -s "12,14,16,18,20,30,40,50,64" --idn --aa4 -n "NotoSans-Black" --zlib -6
	pplfontmaker -t res/notosans.fnt6 -q /usr/share/fonts/google-noto/NotoSans-Regular.ttf -s "8,10,12,14,16,18,20,30" --idn --aa4 -n "NotoSans" --zlib -6
	pplfontmaker -t res/notosans.fnt6 -q /usr/share/fonts/google-noto/NotoSans-Bold.ttf -s "8,10,12,14,16,18,20,30" --idn --aa4 -n "NotoSans" --zlib -6 --isbold


update_version:
	@mkdir -p tmp
	@echo "#ifndef VERSION_H_" > tmp/version.h
	@echo "#define VERSION_H_" >> tmp/version.h
	@echo "#define APP_VERSION \"$(VERSION)\"" >> tmp/version.h
	@echo "#define APP_REVSION \"$(BUILD_NUMBER)\"" >> tmp/version.h
	@echo "#define APP_BUILDDATE $(BUILDDATE)" >> tmp/version.h
	@echo "#endif" >> tmp/version.h
	@diff tmp/version.h include/version.h > /dev/null 2>&1; if [ $$? -ne 0 ] ; then cp tmp/version.h include/version.h; fi

compile/main.o: src/main.cpp Makefile include/sdl.h include/game.h
	- @mkdir -p compile
	$(CXX) -o compile/main.o -c src/main.cpp $(CFLAGS)

compile/sdl.o: src/sdl.cpp Makefile include/sdl.h
	- @mkdir -p compile
	$(CXX) -o compile/sdl.o -c src/sdl.cpp $(CFLAGS)

compile/gpu.o: src/gpu.cpp Makefile include/gpu.h
	- @mkdir -p compile
	$(CXX) -o compile/gpu.o -c src/gpu.cpp $(CFLAGS)

compile/gpubatcher.o: src/gpubatcher.cpp Makefile include/gpu.h
	- @mkdir -p compile
	$(CXX) -o compile/gpubatcher.o -c src/gpubatcher.cpp $(CFLAGS)

compile/game.o: src/game/game.cpp Makefile include/game.h include/version.h \
	include/renderpipelines.h
	- @mkdir -p compile
	$(CXX) -o compile/game.o -c src/game/game.cpp $(CFLAGS)

compile/config.o: src/game/config.cpp Makefile include/game.h
	- @mkdir -p compile
	$(CXX) -o compile/config.o -c src/game/config.cpp $(CFLAGS)

compile/fps.o: src/game/fps.cpp Makefile include/game.h
	- @mkdir -p compile
	$(CXX) -o compile/fps.o -c src/game/fps.cpp $(CFLAGS)

compile/renderpipelines.o: src/game/renderpipelines.cpp Makefile include/renderpipelines.h
	- @mkdir -p compile
	$(CXX) -o compile/renderpipelines.o -c src/game/renderpipelines.cpp $(CFLAGS)

compile/spritetexture.o: src/spritetexture.cpp Makefile include/sprite.h include/gpu.h
	- @mkdir -p compile
	$(CXX) -o compile/spritetexture.o -c src/spritetexture.cpp $(CFLAGS)

compile/gamecontroller.o: src/game/gamecontroller.cpp Makefile include/game.h include/gamecontroller.h
	- @mkdir -p compile
	$(CXX) -o compile/gamecontroller.o -c src/game/gamecontroller.cpp $(CFLAGS)

compile/resources.o: src/game/resources.cpp Makefile include/game.h include/resources.h
	- @mkdir -p compile
	$(CXX) -o compile/resources.o -c src/game/resources.cpp $(CFLAGS)

compile/background.o: src/game/background.cpp Makefile include/game.h
	- @mkdir -p compile
	$(CXX) -o compile/background.o -c src/game/background.cpp $(CFLAGS)


compile/audio_audioinstance.o: src/audio/audioinstance.cpp Makefile include/audio.h
	- @mkdir -p compile
	$(CXX) -o compile/audio_audioinstance.o -c src/audio/audioinstance.cpp $(CFLAGS)

compile/audio_audiopool.o: src/audio/audiopool.cpp Makefile include/audio.h
	- @mkdir -p compile
	$(CXX) -o compile/audio_audiopool.o -c src/audio/audiopool.cpp $(CFLAGS)

compile/audio_audiosample.o: src/audio/audiosample.cpp Makefile include/audio.h
	- @mkdir -p compile
	$(CXX) -o compile/audio_audiosample.o -c src/audio/audiosample.cpp $(CFLAGS)

compile/audio_audiostream.o: src/audio/audiostream.cpp Makefile include/audio.h
	- @mkdir -p compile
	$(CXX) -o compile/audio_audiostream.o -c src/audio/audiostream.cpp $(CFLAGS)

compile/audio_audiosystem.o: src/audio/audiosystem.cpp Makefile include/audio.h
	- @mkdir -p compile
	$(CXX) -o compile/audio_audiosystem.o -c src/audio/audiosystem.cpp $(CFLAGS)


compile/ui_menue.o: src/ui/menue.cpp Makefile include/game.h include/ui/menue.h
	- @mkdir -p compile
	$(CXX) -o compile/ui_menue.o -c src/ui/menue.cpp $(CFLAGS)

compile/ui_statusbar.o: src/ui/statusbar.cpp Makefile include/game.h include/ui/statusbar.h
	- @mkdir -p compile
	$(CXX) -o compile/ui_statusbar.o -c src/ui/statusbar.cpp $(CFLAGS)
