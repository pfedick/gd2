
CC			= @CC@
CXX			= @CXX@
GTEST_CFLAGS = @GTEST_CFLAGS@
GTEST_LIBS = @GTEST_LIBS@
EXTRA_CFLAGS = -ggdb -Wall $(GTEST_CFLAGS)
INCLUDE	= -I. -I../include -I../pplib/include -I../ppltk/include
CFLAGS		=  $(INCLUDE) $(EXTRA_CFLAGS) $(CXXFLAGS) @CFLAGS@ @DEFS@  @PTHREAD_CFLAGS@ \
	@FT2_CFLAGS@ \
	@DAV1D_CFLAGS@ @ZLIB_CFLAGS@ @BZ2_CFLAGS@ @PCRE2_CFLAGS@ @ICONV_CFLAGS@ \
	@MPG123_CFLAGS@	@SDL3_CFLAGS@ @VORBIS_CFLAGS@ @ASSIMP_CFLAGS@
LDFLAGS		= @LDFLAGS@

LIBS_PPL7 =  ../pplib/release/libppl7-audio.a  ../pplib/release/libppl7-gfx.a  ../pplib/release/libppl7-core.a
LIBS_PPLTK = ../ppltk/compile/libppltk.a

LIBS		= $(LIBS_PPLTK)  $(LIBS_PPL7)  $(GTEST_LIBS) @ASAN_FLAGS@ \
	@LIBS@ @PTHREAD_CFLAGS@ @PTHREAD_LIBS@ @DAV1D_LIBS@ @ZLIB_LIBS@ @BZ2_LIBS@ @PCRE2_LIBS@ @FT2_LIBS@ \
	@PNG_LIBS@ @JPEG_LIBS@ @ICONV_LIBS@ @MPG123_LIBS@ @SDL3_LIBS@ @VORBIS_LIBS@ @VORBISFILE_LIBS@ @ASSIMP_LIBS@ \
	-lstdc++

OBJECTS = compile/main.o \
	compile/gameviewport.o

GAME_OBJECTS = ../compile/gameviewport.o

all: test_runner

test_runner: $(OBJECTS) $(GAME_OBJECTS) Makefile
	$(CXX) $(CXXFLAGS) -ggdb -o test_runner $(CFLAGS) $(OBJECTS) $(GAME_OBJECTS) $(LIBS)

clean:
	-rm -rf compile test_runner  *.core


########################################################
compile/main.o: src/main.cpp Makefile
	mkdir -p compile
	$(CXX) $(CXXFLAGS) -o compile/main.o -c src/main.cpp $(CFLAGS)

compile/gameviewport.o: src/gameviewport.cpp Makefile
	mkdir -p compile
	$(CXX) $(CXXFLAGS) -o compile/gameviewport.o -c src/gameviewport.cpp $(CFLAGS)

